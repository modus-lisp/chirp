;;;; test/core.lisp -- sbcl --script test/core.lisp
(require :asdf)
(defvar *root* "/Users/vinnyfiano/workspace/modus-lisp/")
(dolist (r '("natrium" "cram" "chirp")) (push (concatenate 'string *root* r "/") asdf:*central-registry*))
(let ((*standard-output* (make-broadcast-stream))) (asdf:load-system "chirp"))
(in-package #:chirp)
(defvar *fails* 0)
(defun ok (name p) (format t "~&  ~:[FAIL~;ok  ~] ~a~%" p name) (unless p (incf *fails*)))

;; ---- packets ----
(let* ((p (make-packet :type +message+ :ttl 7 :timestamp 1700000000123 :sender (u8v 8)
                       :payload (utf8 "hi")))
       (f (encode-packet p)))
  (ok "a v1 frame: 14 header + 8 sender + payload" (= (length f) (+ 14 8 2)))
  (ok "its header, big-endian" (equalp (subseq f 0 14) #(1 2 7 0 0 1 #x8b #xcf #xe5 #x68 #x7b 0 0 2)))
  (let ((q (decode-packet f)))
    (ok "read back" (and (= (packet-timestamp q) 1700000000123) (equalp (packet-payload q) (utf8 "hi"))
                         (null (packet-recipient q)) (null (packet-signature q))))))
(let* ((p (make-packet :type +message+ :recipient #(1 2 3 4 5 6 7 8) :sender #(9 9 9 9 9 9 9 9)
                       :payload (u8v 3) :signature (u8v 64)))
       (q (decode-packet (encode-packet p :padding t))))
  (ok "padded to 256, read back with its recipient and signature"
      (and (= (length (encode-packet p :padding t)) 256) (equalp (packet-recipient q) #(1 2 3 4 5 6 7 8))
           (= (length (packet-signature q)) 64) (= (logand (packet-flags q) 3) 3))))
(let* ((text (make-string 300 :initial-element #\a))
       (body (utf8 text))
       (z (cram:deflate-compress body))
       (wire (concatenate 'u8v (vector (ash (length body) -8) (logand (length body) #xff)) z))
       (f (encode-packet (make-packet :type +message+ :sender (u8v 8) :wire wire :payload body))))
  (let ((q (decode-packet f)))
    (ok "a compressed payload (raw DEFLATE) read" (equalp (packet-payload q) body))
    (ok "and kept as it came, to re-send and to check" (equalp (encode-packet q) f))))
(ok "a frame too short is refused" (handler-case (progn (decode-packet (u8v 10)) nil) (bad-packet () t)))

;; ---- identity and announce ----
(let* ((me (new-identity "alice"))
       (id (identity-peer-id me)))
  (ok "a peer id: 8 bytes of SHA-256 of the Noise key" (equalp id (subseq (natrium:sha256 (identity-noise-public me)) 0 8)))
  (multiple-value-bind (nick noise sign) (read-announce (announce-payload me))
    (ok "an announce read back" (and (equal nick "alice") (equalp noise (identity-noise-public me))
                                     (equalp sign (identity-signing-public me)))))
  (ok "kept and read back" (equalp (identity-plist (identity-from-plist (identity-plist me))) (identity-plist me)))
  (ok "UTF-8 both ways" (equal (from-utf8 (utf8 "héllo ✨ 🚲")) "héllo ✨ 🚲")))

;; ---- three nodes in a line: A - B - C ----
(defvar *wire* '())                                     ; frames in flight: (to-node from-link frame)
(defun node (name links)
  "A node whose links are (link . other-node-name) pairs."
  (let ((m nil))
    (setf m (make-mesh :identity (new-identity name)
                       :send (lambda (frame &key link except)
                               (loop for (l . to) in links
                                     when (and (or (null link) (eql l link)) (not (eql l except)))
                                       do (setf *wire* (append *wire* (list (list to l frame))))))))
    m))
(defvar *a* (node "alice" '((1 . :b))))
(defvar *b* (node "bob" '((1 . :a) (2 . :c))))
(defvar *c* (node "carol" '((2 . :b))))
(defvar *events* '())
(defun deliver ()
  (loop while *wire*
        do (destructuring-bind (to link frame) (pop *wire*)
             (let ((m (ecase to (:a *a*) (:b *b*) (:c *c*))))
               (dolist (e (mesh-receive m link frame)) (push (cons to e) *events*))))))
(mesh-link-up *a* 1) (mesh-link-up *b* 1) (mesh-link-up *b* 2) (mesh-link-up *c* 2)
(deliver)
(ok "B knows A and C" (and (gethash (hex (identity-peer-id (mesh-identity *a*))) (mesh-peers *b*))
                           (gethash (hex (identity-peer-id (mesh-identity *c*))) (mesh-peers *b*))))
(ok "C knows A, two hops off, through B's relay"
    (let ((p (gethash (hex (identity-peer-id (mesh-identity *a*))) (mesh-peers *c*))))
      (and p (equal (peer-nickname p) "alice") (null (peer-links p)))))
(setf *events* '())
(mesh-say *a* "hello mesh")
(deliver)
(ok "B hears A" (find-if (lambda (e) (and (eq (car e) :b) (eq (second e) :message)
                                          (equal (chat-text (third e)) "hello mesh"))) *events*))
(ok "C hears A, relayed, with A's nickname"
    (find-if (lambda (e) (and (eq (car e) :c) (eq (second e) :message) (equal (chat-nickname (third e)) "alice")))
             *events*))
(ok "A does not hear itself back" (notany (lambda (e) (eq (car e) :a)) *events*))
(ok "each hears it once" (= 2 (count :message *events* :key #'second)))
;; a forged message: signed by another key
(let* ((mallory (new-identity "mallory"))
       (p (sign-packet (make-packet :type +message+ :timestamp 5 :sender (identity-peer-id (mesh-identity *a*))
                                    :payload (utf8 "send money")) (identity-signing-secret mallory))))
  (ok "a message A did not sign is not shown" (null (mesh-receive *b* 1 (encode-packet p)))))
;; a long message: fragments, through the relay
(setf (mesh-max-frame *a*) 120 *events* '())
(mesh-say *a* (make-string 400 :initial-element #\z))
(ok "a long message goes as fragments" (> (length *wire*) 2))
(deliver)
(ok "and arrives whole, two hops on"
    (find-if (lambda (e) (and (eq (car e) :c) (eq (second e) :message) (= 400 (length (chat-text (third e))))))
             *events*))
;; leave
(setf *events* '())
(let ((f (encode-packet (mesh-leave-frame *c*)))) (%emit *c* f) (deliver))
(ok "C's leave: A and B forget it" (= 2 (count :leave *events* :key #'second)))
(format t "~&~:[ALL OK~;~:*~D FAILED~]~%" (and (plusp *fails*) *fails*))
